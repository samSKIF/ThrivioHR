{
  "name": "workspace",
  "version": "1.0.0",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:identity": "jest --config services/identity/jest.config.ts --runInBand",
    "test:web": "NODE_ENV=test pnpm exec jest --config apps/web/jest.config.ts --runInBand",
    "db:check": "drizzle-kit check",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:web:test": "tsc --noEmit -p apps/web/tsconfig.test.json",
    "dev": "nx run-many --target=serve --projects=bff,web --parallel",
    "lint": "nx run-many --target=lint --projects=bff,web",
    "typecheck": "pnpm -s typecheck:web && tsc --noEmit -p apps/bff/tsconfig.json",
    "build:all": "nx run-many --target=build --projects=bff,web",
    "workflows:health": "echo '--- BFF (wf@8000) ---' && curl -sf http://localhost:8000/health && echo '\\n--- Web (wf@5000, root) ---' && curl -s -o /dev/null -w '%{http_code}\\n' http://localhost:5000",
    "dev:alt": "PORT=8001 nx serve bff & PORT=3001 nx serve web",
    "health:alt": "echo '--- BFF (alt@8001) ---' && curl -sf http://localhost:8001/health && echo '\\n--- Web (alt@3001, /) ---' && curl -s -o /dev/null -w '%{http_code}\\n' http://localhost:3001",
    "build": "nx run-many -t build --all",
    "test:ci": "pnpm -s typecheck && pnpm -s lint && pnpm -s test:web -- --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
